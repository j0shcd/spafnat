# Cloudflare Pages Functions - Local Development Environment Variables
# Copy this file to .dev.vars and fill in actual values
# WARNING: Never commit .dev.vars - it contains secrets!

# Phase 2: Contact Form & Visitor Counter
# ========================================

# Resend API Key (get from https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here

# Contact Form Email Recipient
CONTACT_RECIPIENT=joshua@cohendumani.com

# Optional production allowlist for request Origin header.
# Comma-separated entries; each entry may be:
# - full origin (https://spafnat.com)
# - hostname (spafnat.com)
# - wildcard subdomains (*.spafnat.pages.dev)
ALLOWED_ORIGINS=http://localhost:8080,https://spafnat.com,https://www.spafnat.com,*.spafnat.pages.dev


# Phase 3: Admin Panel & File Management
# =======================================

# JWT Secret - Generate with:
#   openssl rand -base64 32
# Paste the result into the single JWT_SECRET entry in .dev.vars.
JWT_SECRET=your-jwt-secret-here

# Admin Password Hash - Generate with:
#   node --import tsx/esm scripts/generate-password-hash.ts
# Use a unique password of at least 16 characters from your password manager.
# Format: salt:hash (both base64-encoded)
ADMIN_PASSWORD_HASH=your-password-hash-here


# Quick Setup Commands
# ====================
# 1. Copy this file: cp -n .dev.vars.example .dev.vars
# 2. Add your Resend API key from https://resend.com/api-keys
# 3. Run openssl rand -base64 32 and replace the JWT_SECRET placeholder (do not append a second entry).
# 4. Run node --import tsx/esm scripts/generate-password-hash.ts (hidden prompt; no password argument).
# 5. Copy the hash output and add to .dev.vars manually
